---
import { getImage } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostHeader from '../components/post-header.astro';
import Document from '../layouts/document.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const date = new Date(post.data.date);

const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);

// PostHeader serves responsive WebP; JPEG is the conservative choice for social
// crawlers with uneven WebP support. Quality 80 balances size and fidelity,
// rather than satisfying an Astro or SEO requirement.
const cover = post.data.image?.src;
const socialImage = cover && typeof cover !== 'string'
  ? await getImage({ src: cover, width: Math.min(1200, cover.width), format: 'jpeg', quality: 80 })
  : undefined;
const imagePath = socialImage?.src ?? (typeof cover === 'string' ? cover : '/images/logo-1280-720.png');
const imageWidth = socialImage ? Number(socialImage.attributes.width) : undefined;
const imageHeight = socialImage ? Number(socialImage.attributes.height) : undefined;

const url = `https://arthur.place/${post.id}`;
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  keywords: post.data.keywords,
  datePublished: date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: {
    '@type': 'ImageObject',
    url: new URL(imagePath, 'https://arthur.place').toString(),
    width: imageWidth,
    height: imageHeight,
    caption: post.data.image?.description
  },
  author: { '@type': 'Person', name: 'Arthur Fileti Fiorette', url: 'https://arthur.place' }
});
---

<Document
  markdown={post.data.published ? `/${post.id}.md` : undefined}
  seo={{
    title: post.data.title,
    description: post.data.description,
    keywords: post.data.keywords,
    urlPath: `/${post.id}`,
    imagePath,
    imageAlt: post.data.image?.alt,
    imageWidth,
    imageHeight,
    imageType: socialImage ? 'image/jpeg' : undefined,
    type: 'article',
    // Drafts remain accessible by direct link but must not be indexed.
    noindex: !post.data.published
  }}>
  <Fragment slot='head'>
    <meta property='article:published_time' content={date.toISOString()} />
    <meta property='article:author' content='https://arthur.place' />
    {post.data.keywords.map((keyword) => <meta property='article:tag' content={keyword} />)}
    <script is:inline type='application/ld+json' set:html={ldJson} />
  </Fragment>

  <div class='source-body'>
    <article>
      <PostHeader date={date} post={post} />
      {sections.length > 1 && <details class='article-contents'>
        <summary>on this page</summary>
        <nav aria-label='Table of contents'>
          <ul>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
        </nav>
      </details>}
      <div class='article-copy'><Content /></div>
    </article>
    <section class='article-discussion' aria-labelledby='discussion-heading'>
      <div class='section-heading'><h2 id='discussion-heading'>discussion</h2></div>
      <div class='text-links'>
        <a href='/posts'>← all posts</a>
        <a href={`https://github.com/arthurfiorette/place/issues?q=${encodeURIComponent(`is:issue ${post.data.title}`)}`}>comments on GitHub</a>
      </div>
      <script
        is:inline
        src='https://utteranc.es/client.js'
        repo='arthurfiorette/place'
        issue-term='title'
        label='posts'
        theme='preferred-color-scheme'
        crossorigin='anonymous'
        async></script>
    </section>
  </div>

  <script is:inline>
    // Scrolling isn't a click, so these can't be class-based goals. The tracker's
    // stub queues the call if the script hasn't loaded yet.
    (() => {
      const copy = document.querySelector('.article-copy');
      if (!copy) return;

      // Progress is where the bottom of the viewport sits inside the article body,
      // so a goal means the reader actually scrolled that far, not just landed.
      const pending = [
        [0.5, 'Article Read 50%'],
        [1, 'Article Read']
      ];

      const check = () => {
        const { top, height } = copy.getBoundingClientRect();
        const progress = (window.innerHeight - top) / height;

        while (pending.length && progress >= pending[0][0]) {
          window.plausible?.(pending.shift()[1]);
        }

        if (!pending.length) window.removeEventListener('scroll', check);
      };

      window.addEventListener('scroll', check, { passive: true });
    })();
  </script>
</Document>
