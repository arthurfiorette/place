---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostHeader from '../components/post-header.astro';
import Section from '../components/section.astro';
import Document from '../layouts/document.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const date = new Date(post.data.date);

const { Content } = await render(post);

const url = `https://arthur.place/${post.id}`;
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  keywords: post.data.keywords,
  datePublished: date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(post.data.image ?? '/images/logo-1280-720.png', 'https://arthur.place').toString(),
  author: { '@type': 'Person', name: 'Arthur Fileti Fiorette', url: 'https://arthur.place' }
});
---

<Document
  markdown={post.data.published ? `/${post.id}.md` : undefined}
  seo={{
    title: post.data.title,
    description: post.data.description,
    keywords: post.data.keywords,
    urlPath: `/${post.id}`,
    imagePath: post.data.image,
    type: 'article',
    // Drafts stay reachable by direct link but must not be indexed.
    noindex: !post.data.published
  }}>
  <Fragment slot='head'>
    <meta property='article:published_time' content={date.toISOString()} />
    <meta property='article:author' content='https://arthur.place' />
    {post.data.keywords.map((keyword) => <meta property='article:tag' content={keyword} />)}
    <script is:inline type='application/ld+json' set:html={ldJson} />
  </Fragment>

  <PostHeader date={date} post={post} />

  <Section class='md prose dark:prose-invert lg:prose-xl w-full max-w-3xl'>
    <Content />
  </Section>

  <script
    is:inline
    src='https://utteranc.es/client.js'
    repo='arthurfiorette/place'
    issue-term='title'
    label='posts'
    theme='preferred-color-scheme'
    crossorigin='anonymous'
    async></script>
</Document>

<style is:global>
  @reference "../styles/global.css";

  .md {
    pre {
      @apply font-mono p-4 rounded-md border border-neutral-700 bg-neutral-950 overflow-x-auto text-sm leading-6;
      font-family: 'Cascadia Code', Consolas, monaco, monospace;
      font-variant-ligatures: common-ligatures;
    }

    :not(pre) > code {
      @apply bg-neutral-800 p-1 rounded-md font-normal text-cream-light;
      font-family: 'Cascadia Code', Consolas, monaco, monospace;
      font-variant-ligatures: common-ligatures;
    }

    a[href] {
      @apply font-normal no-underline hover:underline;
    }

    blockquote {
      @apply font-normal not-italic;
    }

    img {
      @apply mx-auto;
    }
  }
</style>
