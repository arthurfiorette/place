---
import PostCard from '../components/post-card.astro';
import Section from '../components/section.astro';
import Document from '../layouts/document.astro';
import { sortedPosts } from '../util/posts/get-posts';

const years = [...new Set(sortedPosts.map((post) => post.data.date.getUTCFullYear()))];
---

<Document
  markdown='/posts.md'
  seo={{
    title: "Posts | Arthur's place",
    description: 'Backend engineering notes about TypeScript, architecture and open source.',
    urlPath: '/posts'
  }}>
  <div class='source-body'>
    <Section source class='source-intro'>
      <h1>Writing<span class='accent'>.</span></h1>
      <p>Notes on TypeScript, backend architecture, and open source.</p>
      <p class='archive-meta'>{sortedPosts.length} post{sortedPosts.length === 1 ? '' : 's'} <span aria-hidden='true'>/</span> <a href='/rss.xml'>subscribe via RSS</a></p>
    </Section>
    {years.map((year) => <Section source>
      <div class='section-heading'><h2>{year}</h2></div>
      <ul class='post-list'>
        {sortedPosts.filter((post) => post.data.date.getUTCFullYear() === year).map((post) => <li><PostCard data={post} /></li>)}
      </ul>
    </Section>)}
    {!years.length && <p class='empty-note'>No posts yet. Check back soon or subscribe above.</p>}
  </div>
</Document>
