---
import PostCard from '../components/post-card.astro';
import ProjectCard from '../components/project-card.astro';
import Section from '../components/section.astro';
import SocialMediaCard from '../components/social-media-card.astro';
import Document from '../layouts/document.astro';
import { SocialMediaLinks } from '../util/link/social-media';
import { abbrNumber } from '../util/number';
import { sortedPosts } from '../util/posts/get-posts';
import { loadProjects } from '../util/projects';

// Shared with the markdown endpoint so both versions tell the same story.
export const intro = [
  "I'm a senior software developer from Brazil focused on open source and developer tools: build and deploy pipelines, type-safe APIs, code generators and, lately, agent harnesses. Most of my work is TypeScript, with Rust where it pays off."
];
export const history =
  'I started coding in late 2018 with Java, writing Minecraft plugins. Open source came soon after and never left: axios-cache-interceptor, prisma-json-types-generator and the Kita ecosystem all grew out of problems I hit at work, and today the packages I publish see around 10M npm downloads a month. My first job came in 2021, building web apps and deployment automation for a software house, then two years on the backend of a feed management system for cattle farms. From 2024 to 2026 I was at Zephyr Cloud, working on bundler plugins, a multi-cloud edge runtime, billing and the infrastructure of an AI chat platform.';
export const projects = await loadProjects();

export const socialLinks = SocialMediaLinks.filter((link) => [1, 2, 3, 5].includes(link.id));
const stars = projects.reduce((total, project) => total + project.stars, 0);
const monthlyDownloads = projects.reduce((total, project) => total + (Number.isFinite(project.downloads) ? project.downloads * 4 : 0), 0);
const latestPosts = sortedPosts.slice(0, 3);
---

<Document markdown='/index.md'>
  <div class='source-body'>
    <Section source class='source-intro'>
      <p class='source-comment'>// @arthurfiorette</p>
      <h1><span class='text-[var(--link-ink)]'>Arthur Fiorette</span><span class='accent'>.</span></h1>
      {intro.map((paragraph) => <p>{paragraph}</p>)}
    </Section>

    <Section source>
      <div class='text-links'>
        {socialLinks.map((link) => <SocialMediaCard data={link} />)}
      </div>
    </Section>

    <Section source id='projects'>
      <div class='section-heading'><h2>open source</h2></div>
      {(stars > 0 || monthlyDownloads > 0) && <p class='project-totals'>
        {stars > 0 && <span><strong>{abbrNumber(stars)}</strong> GitHub stars</span>}
        {monthlyDownloads > 0 && <span title='Estimate based on the last 7 days of npm downloads, multiplied by 4.'><strong>~{abbrNumber(monthlyDownloads)}</strong> npm downloads / month</span>}
      </p>}
      <ul class='project-list'>
        {projects.map((project) => <li><ProjectCard data={project} /></li>)}
      </ul>
    </Section>

    <Section source id='posts'>
      <div class='section-heading'>
        <h2>writing</h2>
        <a href='/posts'>all posts →</a>
      </div>
      {latestPosts.length ? <ul class='post-list'>
        {latestPosts.map((post) => <li><PostCard data={post} /></li>)}
      </ul> : <p class='empty-note'>No posts yet. <a href='/rss.xml'>Subscribe via RSS</a> for future writing.</p>}
    </Section>

    <Section source>
      <div class='section-heading'><h2>a bit of history</h2></div>
      <p class='history-note'>{history}</p>
    </Section>
  </div>
</Document>
