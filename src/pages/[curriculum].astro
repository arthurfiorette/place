---
import { getCollection } from 'astro:content';
import Document from '../layouts/document.astro';
import '../styles/curriculum.css';

export async function getStaticPaths() {
  const cvs = await getCollection('curriculum');

  return cvs.map((cv) => ({
    params: { curriculum: cv.data.id },
    props: { ...cv, cvs }
  }));
}

const cv = Astro.props;
const portuguese = cv.id === 'pt';
---

<Document
  light
  header={false}
  footer={false}
  lang={portuguese ? 'pt-BR' : 'en'}
  markdown={`/${cv.data.id}.md`}
  seo={{
    title: `${cv.data.name} - ${cv.data.title}`,
    description: `Curriculum of ${cv.data.name}, ${cv.data.title}.`,
    urlPath: `/${cv.data.id}`,
    type: 'profile'
  }}>
  <link slot='head' rel='preload' href='/fonts/source-sans-3/latin.woff2' as='font' type='font/woff2' crossorigin />

  <nav class='cv-actions' aria-label={portuguese ? 'Opções do currículo' : 'Curriculum options'}>
    {cv.cvs.filter((other) => other.id !== cv.id).map((other) => (
      <a href={`/${other.data.id}`} lang={other.id === 'pt' ? 'pt-BR' : 'en'}>
        {other.id === 'pt' ? 'Ler em português' : 'Read in English'}
      </a>
    ))}
    <a href={`/${cv.data.id}.pdf`}>{portuguese ? 'Baixar PDF' : 'Download PDF'}</a>
    <a href='/'>{portuguese ? 'Página inicial' : 'Homepage'}</a>
  </nav>

  <header class='cv-header'>
    <h1>{cv.data.name}</h1>
    <p class='cv-role'>{cv.data.title}</p>
    <ul class='cv-contact' aria-label={portuguese ? 'Contato' : 'Contact'}>
      <li><a href={`mailto:${cv.data.email}`}>{cv.data.email}</a></li>
      <li><a href={`tel:${cv.data.phone.replace(/[^+\d]/g, '')}`}>{cv.data.phone}</a></li>
    </ul>
    <ul class='cv-contact'>
      <li><a href='https://arthur.place'>arthur.place</a></li>
      <li><a href='https://linkedin.com/in/arthurfiorette'>linkedin.com/in/arthurfiorette</a></li>
    </ul>
  </header>

  <section class='cv-summary' aria-label={portuguese ? 'Resumo profissional' : 'Professional summary'}>
    {cv.data.about.map((paragraph) => <p set:html={paragraph} />)}
  </section>

  <section class='cv-section' aria-labelledby='experience'>
    <h2 id='experience'>{cv.data.experienceName}</h2>
    <ul class='cv-entries'>
      {cv.data.experiences.map((experience) => (
        <li class='cv-entry'>
          <div class='cv-dates'>
            <div class='cv-period'><span>{experience.start}</span><span>{experience.end}</span></div>
            <small>{experience.type}</small>
          </div>
          <div class='cv-entry-body'>
            <h3><span set:html={experience.title} /></h3>
            {experience.about.map((paragraph) => <p set:html={paragraph} />)}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class='cv-section' aria-labelledby='open-source'>
    <h2 id='open-source'>{cv.data.ossTitle}</h2>
    {cv.data.oss.map((paragraph) => <p set:html={paragraph} />)}
  </section>

  <section class='cv-section' aria-labelledby='education'>
    <h2 id='education'>{cv.data.educationName}</h2>
    <ul class='cv-entries'>
      {cv.data.education.map((education) => (
        <li class='cv-entry cv-education'>
          <div class='cv-dates'>{education.date}</div>
          <div class='cv-entry-body'>
            <h3><span set:html={education.title} /></h3>
            <p class='cv-institution'>{education.institution}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <footer class='cv-updated'>{cv.data.month}</footer>
</Document>
