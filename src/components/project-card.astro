---
import type { CollectionEntry } from 'astro:content';
import { abbrNumber } from '../util/number';

interface Props {
  data: CollectionEntry<'projects'>['data'];
}

const { data } = Astro.props;
// The existing data source returns a week of downloads, not a calendar month.
const monthlyDownloads = data.downloads * 4;
---

<div class='project-row'>
  <div class='project-description'>
    <h3>
      <a href={`https://github.com/${data.owner}/${data.name}`} target='_blank' rel='noopener noreferrer'>
        {data.prettyName}
      </a>
    </h3>
    <p>{data.description}</p>
  </div>
  <div class='project-metrics'>
    {data.stars > 0 && (
      <span title={`${data.stars.toLocaleString('en-US')} GitHub stars`}>
        <span aria-hidden='true'>☆ </span><strong>{abbrNumber(data.stars)}</strong> stars
      </span>
    )}
    {Number.isFinite(monthlyDownloads) && monthlyDownloads > 0 && (
      <span title='Estimated monthly npm downloads: the last 7 days multiplied by 4.'>
        <strong>~{abbrNumber(monthlyDownloads)}</strong> downloads / mo
      </span>
    )}
  </div>
</div>
