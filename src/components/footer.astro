---
interface Props {
  markdown?: string;
}

const { markdown } = Astro.props;
const year = new Date().getFullYear();
---

<footer class='site-footer'>
  <span>Arthur Fiorette © {year}</span>
  <div class='text-links'>
    {markdown && <a href={markdown}>markdown</a>}
    <a href='/rss.xml'>rss</a>
    <a href='https://github.com/arthurfiorette/place'>source</a>
  </div>
</footer>
