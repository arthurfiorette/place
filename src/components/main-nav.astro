---
import { NavLinks } from '../util/link/nav-links';

interface Props {
  class?: string;
}

// Static builds use .html paths; the dev server uses extensionless routes.
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
---

<nav aria-label='Main' class:list={['site-nav', Astro.props.class]}>
  {
    NavLinks.map((navLink) => {
      const isActive = pathname === navLink.href;

      return (
        <a
          href={navLink.href}
          title={navLink.title}
          aria-current={isActive ? 'page' : undefined}>
          {navLink.label}
        </a>
      );
    })
  }
</nav>
