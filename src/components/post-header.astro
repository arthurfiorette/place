---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getReadTime } from '../util/read-time';
import MinRead from './min-read.astro';
import Time from './time.astro';

interface Props {
  date: Date;
  post: CollectionEntry<'blog'>;
}

const { date, post } = Astro.props;
---

<header class='article-header source-block'>
  <a class='back-link' href='/posts'>← all posts</a>
  <h1>{post.data.title}</h1>
  <p class='article-description'>{post.data.description}</p>
  <div class='post-meta'>
    <Time datetime={date} />
    <MinRead minRead={getReadTime(post.body ?? '')} />
    {post.data.published && <a href={`/${post.id}.md`}>markdown</a>}
  </div>
  {post.data.published === 'preview' && <p class='post-status'>This post is a preview and may not be final.</p>}
  {!post.data.published && <p class='post-status'>This post is a draft.</p>}
  {post.data.image && <figure class='article-figure'>
    {typeof post.data.image.src === 'string' ? (
      <img class='article-image' src={post.data.image.src} alt={post.data.image.alt ?? post.data.title} decoding='async' />
    ) : (
      <Image
        class='article-image'
        src={post.data.image.src}
        alt={post.data.image.alt ?? post.data.title}
        layout='constrained'
        width={Math.min(832, post.data.image.src.width)}
        sizes='(max-width: 650px) calc(100vw - 54px), (max-width: 920px) calc(100vw - 88px), 832px'
        format='webp'
        loading='eager'
        decoding='async'
      />
    )}
    {post.data.image.description && <figcaption>{post.data.image.description}</figcaption>}
  </figure>}
</header>
