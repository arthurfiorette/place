---
import   { SEO   } from 'astro-seo';

export interface SeoProps {
  baseUrl?: string;
  description?: string;
  keywords?: string[];
  urlPath?: string;
  title?: string;
  imagePath?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  /** Open Graph type, `article` for blog posts. */
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const SITE_NAME = "Arthur's place";

const {
  baseUrl = 'https://arthur.place',
  description = 'Arthur Fiorette is a senior software developer from Brazil focused on open source and developer tools. Projects, posts and curriculum.',
  keywords = [
    'arthur',
    'fileti',
    'fiorette',
    'resume',
    'portifolio',
    'personal',
    'website',
    'cv',
    'curriculum',
    'vitale'
  ],
  urlPath = '/',
  title = SITE_NAME,
  imagePath = '/images/logo-1280-720.png',
  imageAlt = title,
  imageWidth,
  imageHeight,
  imageType,
  type = 'website',
  noindex = false
} = Astro.props as SeoProps;

const fullUrl = baseUrl && urlPath ? new URL(urlPath, baseUrl).toString() : undefined;
const fullImageUrl = baseUrl && imagePath ? new URL(imagePath, baseUrl).toString() : undefined;
---

<SEO
  title={title}
  description={description}
  canonical={fullUrl}
  noindex={noindex}
  openGraph={{
    basic: {
      title: title ?? '',
      type,
      image: fullImageUrl ?? '',
      url: fullUrl,
    },
    optional: {
      description,
      siteName: SITE_NAME,
    },
    image: {
      url: fullImageUrl,
      alt: imageAlt,
      width: imageWidth,
      height: imageHeight,
      type: imageType,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    creator: '@arthurfiorette',
    title,
    description,
    image: fullImageUrl,
    imageAlt,
  }}
  extend={{
    meta: keywords?.length
      ? [
          {
            name: 'keywords',
            content: keywords.join(', '),
          },
        ]
      : [],
  }}
/>
