---
import type { CollectionEntry } from 'astro:content';
import { getReadTime } from '../util/read-time';
import MinRead from './min-read.astro';
import Time from './time.astro';

interface Props {
  data: CollectionEntry<'blog'>;
}

const { data: { data: post, id, body } } = Astro.props;
---

<article class='post-row'>
  <Time datetime={post.date} className='post-date' />
  <div>
    <h3><a href={`/${id}`}>{post.title}</a></h3>
    <p>{post.description}</p>
    <div class='post-meta'>
      <MinRead minRead={getReadTime(body ?? '')} />
      {!post.published && <span class='post-status'>draft</span>}
      {post.published === 'preview' && <span class='post-status'>preview</span>}
    </div>
  </div>
</article>
