<fieldset class='theme-switch'>
  <legend class='sr-only'>Color theme</legend>
  <span class='theme-label' aria-hidden='true'>theme:</span>
  <label><input id='theme-system' type='radio' name='theme' value='system' checked />system</label>
  <label><input id='theme-light' type='radio' name='theme' value='light' />light</label>
  <label><input id='theme-dark' type='radio' name='theme' value='dark' />dark</label>
</fieldset>
