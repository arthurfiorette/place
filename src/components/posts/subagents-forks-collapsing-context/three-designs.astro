---
// Fig 2: one stream, three designs. Generated by a throwaway script (block geometry and
// per-turn state rules are precomputed); all numbers are placeholders.
import Autoplay from './autoplay.astro';
import './figure.css';
---

<figure class="post-fig f2" aria-describedby="f2-desc">
  <figcaption>
    <p class="post-fig-title">figure 2: one stream, three designs</p>
    <p class="muted">The same session in the order the text describes them: what the context holds at each turn, and how big it is.</p>
  </figcaption>
  <div id="f2-desc" class="sr-only"><slot /></div>

  <div class="controls"><fieldset class="chips turns" data-autoplay="800"><legend>turn</legend><label><input type="radio" name="f2-t" id="f2-t1" />1</label><label><input type="radio" name="f2-t" id="f2-t2" />2</label><label><input type="radio" name="f2-t" id="f2-t3" />3</label><label><input type="radio" name="f2-t" id="f2-t4" />4</label><label><input type="radio" name="f2-t" id="f2-t5" />5</label><label><input type="radio" name="f2-t" id="f2-t6" />6</label><label><input type="radio" name="f2-t" id="f2-t7" />7</label><label><input type="radio" name="f2-t" id="f2-t8" />8</label><label><input type="radio" name="f2-t" id="f2-t9" />9</label><label><input type="radio" name="f2-t" id="f2-t10" />10</label><label><input type="radio" name="f2-t" id="f2-t11" />11</label><label><input type="radio" name="f2-t" id="f2-t12" />12</label><label><input type="radio" name="f2-t" id="f2-t13" />13</label><label><input type="radio" name="f2-t" id="f2-t14" />14</label><label><input type="radio" name="f2-t" id="f2-t15" />15</label><label><input type="radio" name="f2-t" id="f2-t16" />16</label><label><input type="radio" name="f2-t" id="f2-t17" />17</label><label><input type="radio" name="f2-t" id="f2-t18" />18</label><label><input type="radio" name="f2-t" id="f2-t19" />19</label><label><input type="radio" name="f2-t" id="f2-t20" checked />20</label></fieldset><span class="navs"><label class="nav prev" for="f2-t1">← prev</label><label class="nav prev" for="f2-t2">← prev</label><label class="nav prev" for="f2-t3">← prev</label><label class="nav prev" for="f2-t4">← prev</label><label class="nav prev" for="f2-t5">← prev</label><label class="nav prev" for="f2-t6">← prev</label><label class="nav prev" for="f2-t7">← prev</label><label class="nav prev" for="f2-t8">← prev</label><label class="nav prev" for="f2-t9">← prev</label><label class="nav prev" for="f2-t10">← prev</label><label class="nav prev" for="f2-t11">← prev</label><label class="nav prev" for="f2-t12">← prev</label><label class="nav prev" for="f2-t13">← prev</label><label class="nav prev" for="f2-t14">← prev</label><label class="nav prev" for="f2-t15">← prev</label><label class="nav prev" for="f2-t16">← prev</label><label class="nav prev" for="f2-t17">← prev</label><label class="nav prev" for="f2-t18">← prev</label><label class="nav prev" for="f2-t19">← prev</label> <label class="nav next" for="f2-t2">next →</label><label class="nav next" for="f2-t3">next →</label><label class="nav next" for="f2-t4">next →</label><label class="nav next" for="f2-t5">next →</label><label class="nav next" for="f2-t6">next →</label><label class="nav next" for="f2-t7">next →</label><label class="nav next" for="f2-t8">next →</label><label class="nav next" for="f2-t9">next →</label><label class="nav next" for="f2-t10">next →</label><label class="nav next" for="f2-t11">next →</label><label class="nav next" for="f2-t12">next →</label><label class="nav next" for="f2-t13">next →</label><label class="nav next" for="f2-t14">next →</label><label class="nav next" for="f2-t15">next →</label><label class="nav next" for="f2-t16">next →</label><label class="nav next" for="f2-t17">next →</label><label class="nav next" for="f2-t18">next →</label><label class="nav next" for="f2-t19">next →</label><label class="nav next" for="f2-t20">next →</label></span></div>
  <div class="controls">
    <fieldset class="chips"><legend class="sr-only">cache</legend><label><input type="checkbox" id="f2-cache" checked />show cached prefix</label></fieldset>
    <span class="consts">2K per message · build loop 42K · window 80K · typical compacts at 72K</span>
  </div>
  <p class="turnlab" aria-hidden="true"></p>

  <div class="stage">
    <div class="stage-inner">
      <section class="panel" aria-label="1st typical">
        <div class="head"><p class="ptitle"><span class="k k-ty">1st typical</span> <b class="rd rd-ty"></b></p></div>
        <svg class="mini" viewBox="0 0 300 112" role="img" aria-label="Typical: climbs through the build loop to 71K, compacts at turn 15, climbs again."><path class="gl" d="M34 94H296"/><text class="axt" x="28" y="97" text-anchor="end">0</text><path class="gl" d="M34 75H296"/><text class="axt" x="28" y="78" text-anchor="end">20K</text><path class="gl" d="M34 56H296"/><text class="axt" x="28" y="59" text-anchor="end">40K</text><path class="gl" d="M34 37H296"/><text class="axt" x="28" y="40" text-anchor="end">60K</text><path class="gl" d="M34 18H296"/><text class="axt" x="28" y="21" text-anchor="end">80K</text><path class="win" d="M34 18H296"/><rect class="band" x="68" y="10" width="95.2" height="86"/><text class="bandt" x="115.6" y="105" text-anchor="middle">build loop t4..t10</text><path class="ln ln-ty" d="M34 77.9L47.6 76L61.2 74.1L74.8 73.1L88.4 42.7L102 40.8L115.6 39.9L129.2 38L142.8 37L156.4 34.2L170 32.3L183.6 30.4L197.2 28.5L210.8 26.6L217.6 26.6V75L224.4 73.1L238 71.2L251.6 69.3L265.2 67.4L278.8 65.5L292.4 63.6"/><rect class="future" x="35" y="10" width="300" height="86"/><path class="ph-line" d="M34 6V96"/><text class="evt late-c" x="222.6" y="46.5">compaction</text><text class="axt" x="34" y="110">t1</text><text class="axt" x="296" y="110" text-anchor="end">t20</text></svg>
        <div class="rowbox" aria-hidden="true">
          <div class="row"><i class="blk sys" style="--a:1;--w:15" title="t0 system prompt + tools">sys + tools</i><i class="blk user" style="--a:1;--r:15;--w:2" title="t1 user: add a background job that exports orders to CSV">u</i><i class="blk msg" style="--a:2;--r:15;--w:2" title="t2 explore: reads src/jobs/, db/schema.ts">e</i><i class="blk msg" style="--a:3;--r:15;--w:2" title="t3 claim query in src/jobs/claim.ts">q</i><i class="blk run" style="--a:4;--r:15;--w:1" title="t4 $ pnpm build">$</i><i class="blk log" style="--a:5;--r:15;--w:32" title="t5 log ✗ TS2322 in src/client/api.ts, ~400 lines">log ✗ TS2322 ~400 lines</i><i class="blk msg" style="--a:6;--r:15;--w:2" title="t6 guess: change the field type in src/client/api.ts by hand">g</i><i class="blk user" style="--a:7;--r:15;--w:1" title="t7 user: don't edit generated files">u</i><i class="blk msg" style="--a:8;--r:15;--w:2" title="t8 the errors are all in the generated client, regenerating it">m</i><i class="blk run" style="--a:9;--r:15;--w:1" title="t9 $ pnpm generate &amp;&amp; pnpm build">$</i><i class="blk run" style="--a:10;--r:15;--w:3" title="t10 ✓ done in 41s">✓</i><i class="blk msg" style="--a:11;--r:15;--w:2" title="t11 frontend: wire the export button">fe</i><i class="blk msg" style="--a:12;--r:15;--w:2" title="t12 frontend, continued">fe</i><i class="blk msg" style="--a:13;--r:15;--w:2" title="t13 frontend, continued">fe</i><i class="blk msg" style="--a:14;--r:15;--w:2" title="t14 frontend, continued">fe</i><i class="blk sum" style="--a:15;--w:5" title="t15 compaction: a summary over the whole session plus the most recent turns kept verbatim">sum</i><i class="blk msg" style="--a:15;--w:2" title="t15 frontend, continued">fe</i><i class="blk msg" style="--a:16;--w:2" title="t16 frontend, continued">fe</i><i class="blk msg" style="--a:17;--w:2" title="t17 frontend, continued">fe</i><i class="blk msg" style="--a:18;--w:2" title="t18 frontend, continued">fe</i><i class="blk msg" style="--a:19;--w:2" title="t19 frontend, continued">fe</i><i class="blk msg" style="--a:20;--w:2" title="t20 frontend, continued">fe</i></div>
          <p class="rnote"><span class="late-comp">t15: window nearly full, one summary plus the latest turns</span></p>
          <span class="winmark"></span>
        </div>
      </section>

      <section class="panel" aria-label="2nd subagent">
        <div class="head">
          <p class="ptitle">
            <span class="k k-sm">2nd subagent</span>
            <span class="sub">main <b class="rd rd-sm"></b> child <b class="rd rd-sc"></b></span>
          </p>
          <fieldset class="chips">
            <legend class="sr-only">2nd panel case</legend>
            <label><input type="radio" name="f2-sub" id="f2-del" checked />delegated</label>
            <label><input type="radio" name="f2-sub" id="f2-miss" />didn't realize it needed a subagent</label>
          </fieldset>
        </div>
        <svg class="mini" viewBox="0 0 300 112" role="img" aria-label="Subagent: delegated, the main line stays flat while a separate child line starts at 16K and climbs to 57K. Not delegated, the main line climbs with the loop and only drops at compaction."><path class="gl" d="M34 94H296"/><text class="axt" x="28" y="97" text-anchor="end">0</text><path class="gl" d="M34 75H296"/><text class="axt" x="28" y="78" text-anchor="end">20K</text><path class="gl" d="M34 56H296"/><text class="axt" x="28" y="59" text-anchor="end">40K</text><path class="gl" d="M34 37H296"/><text class="axt" x="28" y="40" text-anchor="end">60K</text><path class="gl" d="M34 18H296"/><text class="axt" x="28" y="21" text-anchor="end">80K</text><path class="win" d="M34 18H296"/><rect class="band" x="68" y="10" width="95.2" height="86"/><text class="bandt" x="115.6" y="105" text-anchor="middle">build loop t4..t10</text><g class="vdel"><path class="ln ln-sm" d="M34 77.9L47.6 76L61.2 74.1L74.8 73.1L88.4 73.1L102 73.1L115.6 72.2L129.2 72.2L142.8 72.2L156.4 71.2L170 69.3L183.6 67.4L197.2 65.5L210.8 63.6L224.4 61.7L238 59.8L251.6 57.9L265.2 56L278.8 54.1L292.4 52.2"/><path class="ln ln-sc" d="M68 78.8L74.8 77.9L88.4 47.5L102 45.6L115.6 45.6L129.2 43.7L142.8 42.7L156.4 39.9"/></g><g class="vmiss"><path class="ln ln-sm" d="M34 77.9L47.6 76L61.2 74.1L74.8 73.1L88.4 42.7L102 40.8L115.6 39.9L129.2 38L142.8 37L156.4 34.2L170 32.3L183.6 30.4L197.2 28.5L210.8 26.6L217.6 26.6V75L224.4 73.1L238 71.2L251.6 69.3L265.2 67.4L278.8 65.5L292.4 63.6"/></g><rect class="future" x="35" y="10" width="300" height="86"/><path class="ph-line" d="M34 6V96"/><g class="vmiss"><text class="evt late-c" x="222.6" y="46.5">compaction</text></g><text class="axt" x="34" y="110">t1</text><text class="axt" x="296" y="110" text-anchor="end">t20</text></svg>
        <div class="rowbox" aria-hidden="true">
          <div class="row del"><i class="blk sys" style="--a:1;--w:15" title="t0 system prompt + tools">sys + tools</i><i class="blk user" style="--a:1;--w:2" title="t1 user: add a background job that exports orders to CSV">u</i><i class="blk msg" style="--a:2;--w:2" title="t2 explore: reads src/jobs/, db/schema.ts">e</i><i class="blk msg" style="--a:3;--w:2" title="t3 claim query in src/jobs/claim.ts">q</i><i class="blk call" style="--a:4;--w:1" title="t4 task prompt for the child">→</i><i class="blk user" style="--a:7;--w:1" title="t7 user: don't edit generated files">u</i><i class="blk rep" style="--a:10;--w:1" title="t10 the child reports back one message">←</i><i class="blk msg" style="--a:11;--w:2" title="t11 frontend: wire the export button">fe</i><i class="blk msg" style="--a:12;--w:2" title="t12 frontend, continued">fe</i><i class="blk msg" style="--a:13;--w:2" title="t13 frontend, continued">fe</i><i class="blk msg" style="--a:14;--w:2" title="t14 frontend, continued">fe</i><i class="blk msg" style="--a:15;--w:2" title="t15 frontend, continued">fe</i><i class="blk msg" style="--a:16;--w:2" title="t16 frontend, continued">fe</i><i class="blk msg" style="--a:17;--w:2" title="t17 frontend, continued">fe</i><i class="blk msg" style="--a:18;--w:2" title="t18 frontend, continued">fe</i><i class="blk msg" style="--a:19;--w:2" title="t19 frontend, continued">fe</i><i class="blk msg" style="--a:20;--w:2" title="t20 frontend, continued">fe</i></div>
          <div class="row miss"><i class="blk sys" style="--a:1;--w:15" title="t0 system prompt + tools">sys + tools</i><i class="blk user" style="--a:1;--r:15;--w:2" title="t1 user: add a background job that exports orders to CSV">u</i><i class="blk msg" style="--a:2;--r:15;--w:2" title="t2 explore: reads src/jobs/, db/schema.ts">e</i><i class="blk msg" style="--a:3;--r:15;--w:2" title="t3 claim query in src/jobs/claim.ts">q</i><i class="blk run" style="--a:4;--r:15;--w:1" title="t4 $ pnpm build">$</i><i class="blk log" style="--a:5;--r:15;--w:32" title="t5 log ✗ TS2322 in src/client/api.ts, ~400 lines">log ✗ TS2322 ~400 lines</i><i class="blk msg" style="--a:6;--r:15;--w:2" title="t6 guess: change the field type in src/client/api.ts by hand">g</i><i class="blk user" style="--a:7;--r:15;--w:1" title="t7 user: don't edit generated files">u</i><i class="blk msg" style="--a:8;--r:15;--w:2" title="t8 the errors are all in the generated client, regenerating it">m</i><i class="blk run" style="--a:9;--r:15;--w:1" title="t9 $ pnpm generate &amp;&amp; pnpm build">$</i><i class="blk run" style="--a:10;--r:15;--w:3" title="t10 ✓ done in 41s">✓</i><i class="blk msg" style="--a:11;--r:15;--w:2" title="t11 frontend: wire the export button">fe</i><i class="blk msg" style="--a:12;--r:15;--w:2" title="t12 frontend, continued">fe</i><i class="blk msg" style="--a:13;--r:15;--w:2" title="t13 frontend, continued">fe</i><i class="blk msg" style="--a:14;--r:15;--w:2" title="t14 frontend, continued">fe</i><i class="blk sum" style="--a:15;--w:5" title="t15 compaction: a summary over the whole session plus the most recent turns kept verbatim">sum</i><i class="blk msg" style="--a:15;--w:2" title="t15 frontend, continued">fe</i><i class="blk msg" style="--a:16;--w:2" title="t16 frontend, continued">fe</i><i class="blk msg" style="--a:17;--w:2" title="t17 frontend, continued">fe</i><i class="blk msg" style="--a:18;--w:2" title="t18 frontend, continued">fe</i><i class="blk msg" style="--a:19;--w:2" title="t19 frontend, continued">fe</i><i class="blk msg" style="--a:20;--w:2" title="t20 frontend, continued">fe</i></div>
          <div class="row child"><i class="blk sys" style="--a:4;--w:15" title="child: its own system prompt + tools, a fresh write unless the same subagent ran within the cache lifetime">sys + tools</i><i class="blk task" style="--a:4;--w:1" title="child: the task, as written by the parent">t</i><i class="blk run" style="--a:4;--w:1" title="t4 $ pnpm build">$</i><i class="blk log" style="--a:5;--w:32" title="t5 log ✗ TS2322 in src/client/api.ts, ~400 lines">log ✗ TS2322 ~400 lines</i><i class="blk msg" style="--a:6;--w:2" title="t6 guess: change the field type in src/client/api.ts by hand">g</i><i class="blk msg" style="--a:8;--w:2" title="t8 the errors are all in the generated client, regenerating it">m</i><i class="blk run" style="--a:9;--w:1" title="t9 $ pnpm generate &amp;&amp; pnpm build">$</i><i class="blk run" style="--a:10;--w:3" title="t10 ✓ done in 41s">✓</i></div>
          <div class="row empty"></div>
          <p class="rnote"><span class="del">└ child <span class="late-end">· transcript kept, not referenced</span></span><span class="miss">no subagent call: the logs stay unless you rerun from before the loop</span></p>
          <span class="winmark"></span>
        </div>
      </section>

      <section class="panel" aria-label="3rd collapse">
        <div class="head"><p class="ptitle"><span class="k k-co">3rd collapse</span> <b class="rd rd-co"></b></p></div>
        <svg class="mini" viewBox="0 0 300 112" role="img" aria-label="Collapse: climbs through the loop to 63K, then the agent notices the episode is over and folds back to 25K."><path class="gl" d="M34 94H296"/><text class="axt" x="28" y="97" text-anchor="end">0</text><path class="gl" d="M34 75H296"/><text class="axt" x="28" y="78" text-anchor="end">20K</text><path class="gl" d="M34 56H296"/><text class="axt" x="28" y="59" text-anchor="end">40K</text><path class="gl" d="M34 37H296"/><text class="axt" x="28" y="40" text-anchor="end">60K</text><path class="gl" d="M34 18H296"/><text class="axt" x="28" y="21" text-anchor="end">80K</text><path class="win" d="M34 18H296"/><rect class="band" x="68" y="10" width="95.2" height="86"/><text class="bandt" x="115.6" y="105" text-anchor="middle">build loop t4..t10</text><path class="ln ln-co" d="M34 77.9L47.6 76L61.2 74.1L74.8 73.1L88.4 42.7L102 40.8L115.6 39.9L129.2 38L142.8 37L156.4 34.2L163.2 34.2V72.2L170 70.3L183.6 68.4L197.2 66.5L210.8 64.6L224.4 62.7L238 60.8L251.6 58.9L265.2 57L278.8 55.1L292.4 53.2"/><rect class="future" x="35" y="10" width="300" height="86"/><path class="ph-line" d="M34 6V96"/><text class="evt late-f" y="31.3"><tspan x="170.2">agent notices</tspan><tspan x="170.2" dy="11">the episode is</tspan><tspan x="170.2" dy="11">over and folds</tspan></text><text class="axt" x="34" y="110">t1</text><text class="axt" x="296" y="110" text-anchor="end">t20</text></svg>
        <div class="rowbox" aria-hidden="true">
          <div class="row"><i class="blk sys" style="--a:1;--w:15" title="t0 system prompt + tools">sys + tools</i><i class="blk user" style="--a:1;--w:2" title="t1 user: add a background job that exports orders to CSV">u</i><i class="blk msg" style="--a:2;--w:2" title="t2 explore: reads src/jobs/, db/schema.ts">e</i><i class="blk msg" style="--a:3;--w:2" title="t3 claim query in src/jobs/claim.ts">q</i><i class="blk run" style="--a:4;--r:11;--w:1" title="t4 $ pnpm build">$</i><i class="blk log" style="--a:5;--r:11;--w:32" title="t5 log ✗ TS2322 in src/client/api.ts, ~400 lines">log ✗ TS2322 ~400 lines</i><i class="blk msg" style="--a:6;--r:11;--w:2" title="t6 guess: change the field type in src/client/api.ts by hand">g</i><i class="blk user" style="--a:7;--r:11;--w:1" title="t7 user: don't edit generated files">u</i><i class="blk msg" style="--a:8;--r:11;--w:2" title="t8 the errors are all in the generated client, regenerating it">m</i><i class="blk run" style="--a:9;--r:11;--w:1" title="t9 $ pnpm generate &amp;&amp; pnpm build">$</i><i class="blk run" style="--a:10;--r:11;--w:3" title="t10 ✓ done in 41s">✓</i><i class="blk note" style="--a:11;--w:2" title="t11 one fresh block: the note ↪ b2e4, then the t7 user message">↪</i><i class="blk msg" style="--a:11;--w:2" title="t11 frontend: wire the export button">fe</i><i class="blk msg" style="--a:12;--w:2" title="t12 frontend, continued">fe</i><i class="blk msg" style="--a:13;--w:2" title="t13 frontend, continued">fe</i><i class="blk msg" style="--a:14;--w:2" title="t14 frontend, continued">fe</i><i class="blk msg" style="--a:15;--w:2" title="t15 frontend, continued">fe</i><i class="blk msg" style="--a:16;--w:2" title="t16 frontend, continued">fe</i><i class="blk msg" style="--a:17;--w:2" title="t17 frontend, continued">fe</i><i class="blk msg" style="--a:18;--w:2" title="t18 frontend, continued">fe</i><i class="blk msg" style="--a:19;--w:2" title="t19 frontend, continued">fe</i><i class="blk msg" style="--a:20;--w:2" title="t20 frontend, continued">fe</i></div>
          <div class="row"><span class="gap"></span><i class="blk run arch" style="--a:11;--w:1" title="t4 $ pnpm build">$</i><i class="blk log arch" style="--a:11;--w:32" title="t5 log ✗ TS2322 in src/client/api.ts, ~400 lines">log ✗ TS2322 ~400 lines</i><i class="blk msg arch" style="--a:11;--w:2" title="t6 guess: change the field type in src/client/api.ts by hand">g</i><i class="blk user arch" style="--a:11;--w:1" title="t7 user: don't edit generated files">u</i><i class="blk msg arch" style="--a:11;--w:2" title="t8 the errors are all in the generated client, regenerating it">m</i><i class="blk run arch" style="--a:11;--w:1" title="t9 $ pnpm generate &amp;&amp; pnpm build">$</i><i class="blk run arch" style="--a:11;--w:3" title="t10 ✓ done in 41s">✓</i></div>
          <p class="rnote"><span class="late-end"><span class="acc">↪ b2e4</span> archived, reachable</span></p>
          <span class="winmark"></span>
        </div>
      </section>
    </div>
  </div>

  <p class="legend" aria-hidden="true">
    <span class="lc">cache read</span><span class="lf">fresh write</span><span class="ll">build log</span><span class="ls">summary + recent turns</span><span class="ln2">note ↪ / report ←</span><span class="la">kept outside the context</span>
  </p>
  <Autoplay />
</figure>

<style>
@property --f2-t { syntax: "<number>"; inherits: true; initial-value: 20; }
@property --f2-ty { syntax: "<integer>"; inherits: true; initial-value: 0; }
@property --f2-sm { syntax: "<integer>"; inherits: true; initial-value: 0; }
@property --f2-sc { syntax: "<integer>"; inherits: true; initial-value: 0; }
@property --f2-co { syntax: "<integer>"; inherits: true; initial-value: 0; }
.f2 {
  --f2-t: 20; --cache: 0; --px: 6px;
  letter-spacing: normal;
  transition: --f2-t .5s ease, --f2-ty .5s ease, --f2-sm .5s ease, --f2-sc .5s ease, --f2-co .5s ease;
}
.f2:has(#f2-cache:checked) { --cache: 1; }
.f2 .chips.turns { gap: 4px 9px; }
.f2 .consts { font-size: 11px; color: var(--comment-ink); }
.f2 .turnlab { margin: 4px 0 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.f2 .turnlab::after { content: "turn 20: frontend, continued"; }

.f2 .k-ty { --kc: var(--ink); }
.f2 .k-sm { --kc: var(--link-ink); }
.f2 .k-co { --kc: var(--loop); }
.f2 .rd { display: inline-block; min-width: 4ch; font-weight: 400; color: var(--metric-ink); }
.f2 .rd-ty { counter-reset: n var(--f2-ty); }
.f2 .rd-sm { counter-reset: n var(--f2-sm); }
.f2 .rd-sc { counter-reset: n var(--f2-sc); }
.f2 .rd-co { counter-reset: n var(--f2-co); }
.f2 .rd::after { content: counter(n) "K"; }

/* horizontal scroll inside the figure on narrow screens; relative so the hidden radios stay inside */
.f2 .stage { position: relative; overflow-x: auto; }
.f2 .stage-inner { min-width: 800px; }

.f2 .panel { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 0 14px; align-items: center; margin-top: 14px; }
.f2 .panel > .head { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 4px 28px; }
.f2 .ptitle { display: flex; align-items: baseline; gap: 2px 10px; font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; }
.f2 .ptitle .k { color: var(--kc); }
.f2 .sub { font-weight: 400; color: var(--muted-ink); }

/* context rows: block width = tokens; each block knows when it appears (--a), is removed (--r) and is written (--c) */
.f2 .rowbox { position: relative; display: grid; gap: 6px; padding: 16px 0 0; }
.f2 .row { display: flex; height: 20px; min-width: 0; }
.f2 .blk {
  --r: 99; --c: var(--a); --dim: 0;
  --on: calc(clamp(0, var(--f2-t) - var(--a) + 1, 1) * clamp(0, var(--r) - var(--f2-t), 1));
  --fr: clamp(0, var(--c) + 1 - var(--f2-t), 1);
  flex: none;
  box-sizing: border-box;
  overflow: hidden;
  width: calc(var(--w) * var(--px) * var(--on));
  margin-right: calc(1px * var(--on));
  opacity: calc(var(--on) * (1 - .6 * var(--dim)));
  background: var(--surface-bg);
  box-shadow:
    inset 0 calc(-3px * var(--cache) * (1 - var(--dim))) 0 color-mix(in oklab, var(--metric-ink) calc(var(--fr) * 100%), var(--link-ink)),
    inset 0 0 0 1px var(--rule);
  font-size: 9px; font-style: normal; line-height: 19px; text-align: center; white-space: nowrap; color: var(--muted-ink);
}
.f2 .blk.user, .f2 .blk.call, .f2 .blk.task { color: var(--link-ink); }
.f2 .blk.run { color: var(--loop); }
.f2 .blk.log { background: color-mix(in oklab, var(--loop) 22%, var(--surface-bg)); color: var(--loop); }
.f2 .blk.sum { background: repeating-linear-gradient(135deg, var(--surface-bg) 0 3px, color-mix(in oklab, var(--comment-ink) 30%, var(--surface-bg)) 3px 5px); color: var(--ink); }
.f2 .blk:is(.note, .rep) { background: color-mix(in oklab, var(--accent-ink) 30%, var(--surface-bg)); color: var(--accent-ink); font-weight: 700; }
/* the child's transcript after it reported, and the archive: kept, out of the context */
.f2 .row.child .blk { --dim: clamp(0, var(--f2-t) - 10, 1); }
.f2 .blk.arch { --dim: 1; opacity: calc(var(--on) * .55); background: transparent; box-shadow: none; outline: 1px dashed var(--comment-ink); outline-offset: -1px; color: var(--comment-ink); }
.f2 .gap { flex: none; width: calc(21 * var(--px) + 4px); }
.f2 .row.miss { display: none; }
.f2:has(#f2-miss:checked) .row.miss { display: flex; }
.f2:has(#f2-miss:checked) :is(.row.del, .row.child) { display: none; }
.f2 .row.empty { display: none; }
.f2:has(#f2-miss:checked) .row.empty { display: flex; }

.f2 .rnote { height: 18px; font-size: 11px; line-height: 18px; color: var(--comment-ink); white-space: nowrap; }
.f2 .late-end { opacity: clamp(0, var(--f2-t) - 10, 1); }
.f2 .late-comp { opacity: clamp(0, var(--f2-t) - 14, 1); }
.f2 .rnote .miss { display: none; color: var(--loop); }
.f2:has(#f2-miss:checked) .rnote .miss { display: inline; }
.f2:has(#f2-miss:checked) .rnote .del { display: none; }
.f2 .rnote .acc { color: var(--accent-ink); }
.f2 .winmark { position: absolute; top: 2px; bottom: 0; left: calc(80 * var(--px)); border-left: 1px dashed var(--metric-ink); pointer-events: none; }
.f2 .winmark::after { content: "80K"; position: absolute; top: -4px; left: 3px; font-size: 10px; line-height: 1; color: var(--metric-ink); }

/* mini charts */
.f2 svg.mini { display: block; width: 290px; height: auto; overflow: hidden; }
.f2 svg .gl { stroke: color-mix(in oklab, var(--rule) 55%, transparent); fill: none; }
.f2 svg .axt { fill: var(--comment-ink); font-size: 10px; }
.f2 svg .win { stroke: var(--metric-ink); stroke-dasharray: 5 4; fill: none; }
.f2 svg .band { fill: color-mix(in oklab, var(--loop) 7%, transparent); }
.f2 svg .bandt { fill: var(--loop); font-size: 9px; opacity: .8; }
.f2 svg .evt { fill: var(--metric-ink); font-size: 9.5px; }
.f2 svg .late-c { opacity: clamp(0, var(--f2-t) - 14, 1); }
.f2 svg .late-f { fill: var(--accent-ink); opacity: clamp(0, var(--f2-t) - 10, 1); }
.f2 svg .ln { fill: none; stroke: var(--kc); stroke-width: 2; stroke-linejoin: round; }
.f2 svg .ln-ty { --kc: var(--ink); }
.f2 svg .ln-sm { --kc: var(--link-ink); }
.f2 svg .ln-sc { --kc: var(--link-ink); stroke-dasharray: 4 3; stroke-width: 1.5; }
.f2 svg .ln-co { --kc: var(--loop); }
.f2 svg .ph-line { stroke: var(--accent-ink); stroke-width: 1.5; transform: translateX(calc((var(--f2-t) - 1) * 13.6px)); }
.f2 svg .future { fill: var(--page-bg); opacity: .72; transform: translateX(calc((var(--f2-t) - 1) * 13.6px)); }
.f2 svg .vmiss { display: none; }
.f2:has(#f2-miss:checked) svg .vmiss { display: inline; }
.f2:has(#f2-miss:checked) svg .vdel { display: none; }

.f2 .legend { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 14px 0 0; font-size: 11px; color: var(--muted-ink); }
.f2 .legend span::before { content: ""; display: inline-block; width: 14px; height: 8px; margin-right: 6px; vertical-align: middle; box-shadow: inset 0 0 0 1px var(--rule); }
.f2 .legend .lc::before { height: 3px; box-shadow: none; background: var(--link-ink); }
.f2 .legend .lf::before { height: 3px; box-shadow: none; background: var(--metric-ink); }
.f2 .legend .ll::before { background: color-mix(in oklab, var(--loop) 22%, var(--surface-bg)); }
.f2 .legend .ls::before { background: repeating-linear-gradient(135deg, var(--surface-bg) 0 3px, color-mix(in oklab, var(--comment-ink) 30%, var(--surface-bg)) 3px 5px); }
.f2 .legend .ln2::before { background: color-mix(in oklab, var(--accent-ink) 30%, var(--surface-bg)); }
.f2 .legend .la::before { box-shadow: none; outline: 1px dashed var(--comment-ink); outline-offset: -1px; }

@media (prefers-reduced-motion: reduce) {
  .f2 { transition: none; }
}

